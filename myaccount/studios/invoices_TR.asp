<script type="text/javascript">
function docalcs() 
{
    var fee1 = (document.getElementById("tn1").value*20).toFixed(2);
    var disc1 = (document.getElementById("nn1").value*15).toFixed(2);
    var fee2 = (document.getElementById("tn2").value*50).toFixed(2);
    var disc2 = (document.getElementById("nn2").value*45).toFixed(2);
    var fee3 = (document.getElementById("tn3").value*40).toFixed(2);
    var disc3 = (document.getElementById("nn3").value*30).toFixed(2);
    var fee4 = (document.getElementById("tn4").value*40).toFixed(2);
    var disc4 = (document.getElementById("nn4").value*30).toFixed(2);
    var depos = (document.getElementById("deposit").value*1).toFixed(2);
    document.getElementById("fees1").value = (fee1*1).toFixed(2); 
    document.getElementById("d1").value = (disc1*1).toFixed(2);
    document.getElementById("nett1").value = ((fee1*1)+(disc1*1)).toFixed(2);
    document.getElementById("fees2").value = (fee2*1).toFixed(2); 
    document.getElementById("d2").value = (disc2*1).toFixed(2);
    document.getElementById("nett2").value = ((fee2*1)+(disc2*1)).toFixed(2);
    document.getElementById("fees3").value = (fee3*1).toFixed(2); 
    document.getElementById("d3").value = (disc3*1).toFixed(2);
    document.getElementById("nett3").value = ((fee3*1)+(disc3*1)).toFixed(2);
    document.getElementById("fees4").value = (fee4*1).toFixed(2); 
    document.getElementById("d4").value = (disc4*1).toFixed(2);
    document.getElementById("nett4").value = ((fee4*1)+(disc4*1)).toFixed(2);
	document.getElementById("nett5").value = ((fee1*1)+(disc1*1)+(fee2*1)+(disc2*1)+(fee3*1)+(disc3*1)+(fee4*1)+(disc4*1)).toFixed(2);
    var disc = (document.getElementById("discount").value*1).toFixed(2);
    if (disc<=-1) {document.getElementById("TDisc").value='Studio Discount/Atlaide: '};
   	document.getElementById("totaldue").value = ((fee1*1)+(disc1*1)+(fee2*1)+(disc2*1)+(fee3*1)+(disc3*1)+(fee4*1)+(disc4*1)+(disc*1)).toFixed(2);
    var pvn = (document.getElementById("totaldue").value*.21).toFixed(2);
   	document.getElementById("totaldue2").value = ((pvn*0)).toFixed(2);
   	document.getElementById("totaldue1").value = ((fee1*1)+(disc1*1)+(fee2*1)+(disc2*1)+(fee3*1)+(disc3*1)+(fee4*1)+(disc4*1)+(depos*1)+(pvn*0)+(disc*1)).toFixed(2); 
}
window.onload = docalcs();
</script>

