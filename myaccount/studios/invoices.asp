<script type="text/javascript">
function docalcs() 
{

    var fee4 = (document.getElementById("tn4").value*25).toFixed(2);
    var disc4 = (document.getElementById("nn4").value*16).toFixed(2);
    var depos = (document.getElementById("deposit").value*1).toFixed(2);
    document.getElementById("fees4").value = (fee4*1).toFixed(2); 
    document.getElementById("d4").value = (disc4*1).toFixed(2);
    document.getElementById("nett4").value = ((fee4*1)+(disc4*1)).toFixed(2);
	document.getElementById("nett5").value = ((fee4*1)+(disc4*1)).toFixed(2);
    var disc = (document.getElementById("discount").value*1).toFixed(2);
    if (disc<=-1) {document.getElementById("TDisc").value='Studio Discount/Atlaide: '};
   	document.getElementById("totaldue").value = ((fee4*1)+(disc4*1)+(disc*1)).toFixed(2);
    var pvn = (document.getElementById("totaldue").value*.21).toFixed(2);
   	document.getElementById("totaldue2").value = ((pvn*1)).toFixed(2);
   	document.getElementById("totaldue1").value = ((fee4*1)+(disc4*1)+(depos*1)+(pvn*1)+(disc*1)).toFixed(2); 
}
window.onload = docalcs();
</script>

